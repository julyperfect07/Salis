generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DeliveryZone {
  AMMAN_CENTRAL
  AMMAN_WEST
  AMMAN_EAST
  AMMAN_NORTH
  AMMAN_SOUTH
}

enum Role {
  SHOP_OWNER
  DELIVERY_COMPANY
  DRIVER
  ADMIN
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  COLLECTED
  PAID_TO_SHOP
  NOT_COLLECTED
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  password         String
  role             Role
  phoneNumber      String
  imageUrl         String?
  refreshTokenHash String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  shopOwner       ShopOwner?
  driver          Driver?
  deliveryCompany DeliveryCompany?

  @@index([role])
  @@index([isActive])
}

model ShopOwner {
  userId String @id

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
  orders   Order[]
}

model DeliveryCompany {
  userId        String         @id
  deliveryPrice Decimal        @db.Decimal(10, 3)
  openTime      String
  closeTime     String
  coverageZones DeliveryZone[] @default([])

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  drivers Driver[]
  orders  Order[]
}

model Driver {
  userId    String @id
  companyId String

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  company DeliveryCompany @relation(fields: [companyId], references: [userId])
  orders  Order[]

  @@index([companyId])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 3)
  imageUrls   String[] @default([])
  isActive    Boolean  @default(true)
  shopOwnerId String
  createdAt   DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  shopOwner  ShopOwner   @relation(fields: [shopOwnerId], references: [userId])
  orderItems OrderItem[]

  @@index([shopOwnerId, isActive])
}

model Order {
  id                String  @id @default(uuid())
  shopOwnerId       String
  deliveryCompanyId String?
  driverId          String?

  customerName      String
  customerPhone     String
  customerAddress   String
  customerNote      String?
  customerLatitude  Decimal? @db.Decimal(9, 6)
  customerLongitude Decimal? @db.Decimal(9, 6)

  // Product subtotal before delivery and commissions
  totalPrice Decimal @db.Decimal(10, 3)

  // Financial values are captured when the order is created
  deliveryFee               Decimal @default(0) @db.Decimal(10, 3)
  shopCommission            Decimal @default(0) @db.Decimal(10, 3)
  deliveryCompanyCommission Decimal @default(0) @db.Decimal(10, 3)
  customerTotal             Decimal @default(0) @db.Decimal(10, 3)

  pickupCode     String  @unique
  pickupCodeUsed Boolean @default(false)

  deliveryZone  DeliveryZone?
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  returnReason  String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  shopOwner       ShopOwner        @relation(fields: [shopOwnerId], references: [userId])
  deliveryCompany DeliveryCompany? @relation(fields: [deliveryCompanyId], references: [userId])
  driver          Driver?          @relation(fields: [driverId], references: [userId])
  orderItems      OrderItem[]

  @@index([shopOwnerId, status])
  @@index([deliveryCompanyId, status])
  @@index([driverId, status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}
